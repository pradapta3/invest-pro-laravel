# Local development template. For the server, start from
# .env.production.example instead — see DEPLOYMENT.md.

APP_NAME="IDX Invest"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Comma-separated proxy IPs or CIDRs whose X-Forwarded-* headers are believed
# (see bootstrap/app.php). Behind a reverse proxy this must cover it, or Laravel
# builds http:// links on an https:// site.
#
# Note this key is read before Laravel parses .env, so setting it *here* has no
# effect — it only works as a real environment variable, which is how
# docker-compose.yml passes it. Left unset, bootstrap/app.php falls back to
# RFC1918 ranges rather than to "trust nothing"; to genuinely trust no proxy,
# edit that fallback.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_saham
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true wherever the site is served over HTTPS, otherwise the session
# cookie is also sent over plain http and can be captured in transit.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Telegram Bot ------------------------------------------------------
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN.
# TELEGRAM_WEBHOOK_SECRET is a random string YOU choose; set it again as
# the secret_token parameter when calling Telegram's setWebhook so every
# inbound request can be verified as genuinely coming from Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_BROADCAST_CHAT_IDS=
# Without the @ prefix, e.g. "IdxInvestBot". Only used to build the
# t.me/<username>?start=... one-tap link on the Telegram settings page;
# the /LINK <code> flow works without it.
TELEGRAM_BOT_USERNAME=

# --- Google Gemini -------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Sent as generationConfig on every call. Low temperature because these answers
# summarise numbers the app already computed rather than write prose; the token
# cap because the answer has to fit a Telegram bubble or a modal. Raise the cap
# if replies start ending with "(jawaban terpotong)".
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=800

# Cron expression for idx:update-realtime-quotes. One TradingView request
# covers the whole exchange, so a fast cadence is cheap: */5 is 12 requests an
# hour regardless of how many emiten are tracked. '* * * * *' for near-live.
# The weekday and 09:00-16:00 trading-hours window are applied on top of this
# in routes/console.php, so only the frequency is set here.
IDX_REALTIME_CRON="*/5 * * * *"

# --- Market Data ---------------------------------------------------------
YAHOO_FINANCE_VERIFY_SSL=true
TRADINGVIEW_VERIFY_SSL=true

# Optional: comma-separated RSS feeds SentimentAnalysisService rescans.
# Defaults to the 5 legacy update_sentiment.php sources if left unset.
IDX_SENTIMENT_FEEDS=

# --- Portfolio Economics (defaults match the legacy simulator) -----------
TRADING_LOT_SIZE=100
TRADING_BUY_FEE_RATE=0.0015
TRADING_SELL_FEE_RATE=0.0025
TRADING_STARTING_CASH=100000000

BACKTEST_UNIVERSE=150
