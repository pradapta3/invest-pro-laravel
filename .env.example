APP_NAME="IDX Invest"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_saham
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Telegram Bot ------------------------------------------------------
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN.
# TELEGRAM_WEBHOOK_SECRET is a random string YOU choose; set it again as
# the secret_token parameter when calling Telegram's setWebhook so every
# inbound request can be verified as genuinely coming from Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_BROADCAST_CHAT_IDS=

# --- Google Gemini -------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Market Data ---------------------------------------------------------
YAHOO_FINANCE_VERIFY_SSL=true
TRADINGVIEW_VERIFY_SSL=true

# Optional: comma-separated RSS feeds SentimentAnalysisService rescans.
# Defaults to the 5 legacy update_sentiment.php sources if left unset.
IDX_SENTIMENT_FEEDS=

# --- Portfolio Economics (defaults match the legacy simulator) -----------
TRADING_LOT_SIZE=100
TRADING_BUY_FEE_RATE=0.0015
TRADING_SELL_FEE_RATE=0.0025
TRADING_STARTING_CASH=100000000
